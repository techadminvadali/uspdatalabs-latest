NEXT_PUBLIC_APP_URL=

# reCAPTCHA (server-side secret used by /app/api/contact/route.ts)
# Get it from Google reCAPTCHA admin console (v2 checkbox / test as applicable)
RECAPTCHA_SECRET_KEY=

# reCAPTCHA (client-side site key used by contact form)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Contact form routing allowlist (comma-separated).
# The API will only "send" to emails listed here (and always allows fallback RECIPIENT_EMAIL in route.ts).
# Example:
# CONTACT_RECIPIENT_EMAILS=hello@uspdatalabs.com,contact@smartitc.com.sg,contact@fgsc.eu
CONTACT_RECIPIENT_EMAILS=
